DATABASE_URL="file:./dev.db"
PORT=4100
NODE_ENV=development

# Dashboard frontend origin (CORS allowlist for the dashboard).
FRONTEND_ORIGIN="http://localhost:3000"

# Base URL of the hostnsoft-deploy service this API calls into for the
# actual build/deploy mechanics (see ../hostnsoft-deploy).
HOSTNSOFT_DEPLOY_URL="https://ship.embarko.ai"

# Custom domains (see docs/Customdomain-req.md). All required — this
# service fails fast at startup if any is missing.
#
# Dedicated, permanently-unproxied hostname resolving directly to the
# origin server's real IP. This is what clients CNAME their subdomain to
# — never issue the proxied *.app.<platform-domain> hostname for this.
EDGE_HOSTNAME="edge.embarko.ai"
# The origin server's real IP — used for apex-domain A-record
# instructions/verification, and as what EDGE_HOSTNAME itself resolves to.
ORIGIN_SERVER_IP="203.0.113.10"
# The platform's own registrable domain. Customers can't register a custom
# domain that is, or sits under, this zone — a name here would pass DNS
# verification on the origin-IP fallback and then take a Traefik router for
# a platform hostname.
#
# Optional: falls back to the registrable domain of EDGE_HOSTNAME, which is
# correct while that stays `edge.<zone>`. Set it explicitly anyway — this is
# a security control, and deriving it means a mistyped EDGE_HOSTNAME
# silently moves the zone being protected.
PLATFORM_DOMAIN="example.com"
# Authenticates this service's own calls INTO hostnsoft-deploy to push
# custom-domain router config (the reverse direction of the deploy-token
# flow) — must match hostnsoft-deploy's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET="change-me-shared-with-hostnsoft-deploy"
# How often already-active custom domains get re-checked against live DNS,
# in milliseconds. Optional — defaults to 24 hours.
# DOMAIN_REVERIFICATION_INTERVAL_MS=86400000

# Anonymous ("orphan") deploys (see docs/Anonymous-deploy-req.md). Both
# optional — sensible defaults below.
#
# How long an unclaimed orphan project lives before the cleanup job
# deletes it, in milliseconds. Default: 24 hours.
# ORPHAN_TTL_MS=86400000
# How often the cleanup job checks for expired orphan projects, in
# milliseconds. Default: 1 hour.
# ORPHAN_CLEANUP_INTERVAL_MS=3600000


# MSG91 proxy (see src/lib/msg91.ts). PROXY_ADMIN_TOKEN is account-wide —
# server-side only, never in frontend code.
PROXY_BASE_URL="https://routes.msg91.com/api"
PROXY_ADMIN_TOKEN="change-me"
PROXY_USER_REFERENCE_ID="change-me"

# Caches proxy token verification / membership lookups (see src/lib/redis.ts).
REDIS_URL="redis://localhost:6379"

# Billing (see src/lib/lago.ts). Lago owns plans/subscriptions and creates
# the linked Stripe customer; the org-level Stripe connection must already
# be configured in Lago. The API URL and free-plan code are not env vars —
# they live in src/lib/billingUtility.ts.
LAGO_API_KEY="change-me"

# Stripe is called directly only for payment-method management (see
# src/lib/stripe.ts). Server-side only, same rules as PROXY_ADMIN_TOKEN.
STRIPE_SECRET_KEY="sk_test_change-me"

API_PUBLIC_URL="http://localhost:4100"

# Rolling-window limits for POST /public/feature-requests (see
# docs/request-feature-req.md). Same shape as PUBLIC_TOKEN_RATE_* above,
# own counters — a burst of feedback shouldn't affect deploy-token
# requests or vice versa. All optional, sensible defaults shown:
# FEATURE_REQUEST_RATE_WINDOW_MS=3600000
# FEATURE_REQUEST_RATE_PER_EMAIL=10
# FEATURE_REQUEST_RATE_PER_IP=20
# FEATURE_REQUEST_RATE_GLOBAL=500

# Limits for the open GET /billing/plans. Looser than above: it's a read a
# pricing page hits every visit. Optional, defaults shown:
# PUBLIC_PLANS_RATE_WINDOW_MS=3600000
# PUBLIC_PLANS_RATE_PER_IP=120
# PUBLIC_PLANS_RATE_GLOBAL=10000

# Rolling-window per-IP limits for the AI-connector token endpoints (see
# src/routes/connectorAuth.routes.ts) — POST /connector/token (exchange) and
# POST /connector/token/validate. Own counters, same shape as the rate
# limits above. All optional, sensible defaults shown:
# CONNECTOR_TOKEN_RATE_WINDOW_MS=3600000
# CONNECTOR_TOKEN_EXCHANGE_RATE_PER_IP=30
# CONNECTOR_TOKEN_VALIDATE_RATE_PER_IP=120

# AI-connector redirect login (see src/lib/connectorRedirect.ts) — comma-
# separated allowlist of https:// redirect_uri targets an AI connector may
# be redirected back to after MSG91 login (GET /auth/msg91/callback's
# connector branch), matched by parsed origin + normalized path-prefix,
# HTTPS-only. Optional — defaults to viasocket's MCP OAuth callback if
# unset; override/extend only when onboarding another connector platform.
# CONNECTOR_ALLOWED_REDIRECT_PREFIXES=https://mcp.viasocket.com/oauth/

# Showcase (see docs/showcase.md). Optional. The hostname deployed apps are
# served under as <slug>.<domain>; a listing's "Open app" URL is derived
# from it when the project has no active custom domain.
# APP_PUBLIC_DOMAIN=embarko.ai

# How long an app must wait between web-address changes, in milliseconds
# (see src/services/projectSlugChange.ts). Optional — defaults to 7 days.
# Not an anti-abuse throttle so much as a budget guard: the platform zone
# has no wildcard certificate, so every live address change orders a
# fresh Let's Encrypt certificate for the new hostname, out of a weekly
# per-domain budget shared with every new app signing up. Applies to both
# the dashboard and the agent endpoint — it is read off the audit log,
# which records who did it but is not filtered by actor. Set to 0 to
# disable (useful in a test environment).
# SLUG_CHANGE_COOLDOWN_MS=604800000
