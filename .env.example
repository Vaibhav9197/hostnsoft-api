DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4100
NODE_ENV=development

# Dashboard frontend origin — required (not "*") for the httpOnly refresh
# token cookie in src/routes/auth.routes.ts to work cross-origin.
FRONTEND_ORIGIN="http://localhost:3000"

# Base URL of the hostnsoft-deploy service this API calls into for the
# actual build/deploy mechanics (see ../hostnsoft-deploy).
HOSTNSOFT_DEPLOY_URL="https://ship.hostnsoft.com"

# MSG91 proxy-auth verification (see src/lib/msg91.ts). MSG91_AUTHKEY is
# ACCOUNT-WIDE — it must only ever live here, server-side. If it's ever
# used in frontend/browser code, treat it as compromised and rotate it in
# the MSG91 dashboard immediately.
MSG91_AUTHKEY="change-me"
MSG91_GENERATE_AUTH_TOKEN_URL="https://routes.msg91.com/api/<account-id>/generateAuthToken"

# Custom domains (see docs/Customdomain-req.md). All required — this
# service fails fast at startup if any is missing.
#
# Dedicated, permanently-unproxied hostname resolving directly to the
# origin server's real IP. This is what clients CNAME their subdomain to
# — never issue the proxied *.app.<platform-domain> hostname for this.
EDGE_HOSTNAME="edge.hostnsoft.com"
# The origin server's real IP — used for apex-domain A-record
# instructions/verification, and as what EDGE_HOSTNAME itself resolves to.
ORIGIN_SERVER_IP="203.0.113.10"
# Authenticates this service's own calls INTO hostnsoft-deploy to push
# custom-domain router config (the reverse direction of the deploy-token
# flow) — must match hostnsoft-deploy's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET="change-me-shared-with-hostnsoft-deploy"
# How often already-active custom domains get re-checked against live DNS,
# in milliseconds. Optional — defaults to 24 hours.
# DOMAIN_REVERIFICATION_INTERVAL_MS=86400000

# Anonymous ("orphan") deploys (see docs/Anonymous-deploy-req.md). Both
# optional — sensible defaults below.
#
# How long an unclaimed orphan project lives before the cleanup job
# deletes it, in milliseconds. Default: 24 hours.
# ORPHAN_TTL_MS=86400000
# How often the cleanup job checks for expired orphan projects, in
# milliseconds. Default: 1 hour.
# ORPHAN_CLEANUP_INTERVAL_MS=3600000
