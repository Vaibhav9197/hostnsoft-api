// Identity lives on MSG91 proxy: there is deliberately no User, Company or
// CompanyMembership model. Every userId/companyId below is a plain string
// holding the PROXY id — no foreign key, since the referenced rows aren't
// ours. Consequence: a company deleted on proxy leaves its Project and
// DeployToken rows orphaned (nothing signals us).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Company-wide deploy token. Only the hash is stored; the raw token is shown
// once at creation, like a GitHub PAT. The token IS the company identity for
// hostnsoft-deploy (src/services/deployTokenAuth.ts).
model DeployToken {
  id          String    @id @default(cuid())
  companyId   String
  createdBy   String
  label       String
  tokenHash   String    @unique
  tokenPrefix String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  // Where the token was minted: "dashboard" (a person in the UI), "agent"
  // (the public email endpoint), or "connector" (an AI client exchanging a
  // proxy_auth_token via POST /connector/token). String, not enum — SQLite.
  source      String    @default("dashboard")

  @@index([companyId])
}

// One Project == one deployed app on hostnsoft-deploy. slug is immutable —
// it's the subdomain hostnsoft-deploy routes by (<slug>.embarko.app)
// and the X-App-Name it expects; name is just a display label.
// companyId/createdBy are null only for orphan (anonymous) projects — see
// docs/Anonymous-deploy-req.md — until a real deploy token claims them.
model Project {
  id        String   @id @default(cuid())
  companyId String?
  createdBy String?
  slug      String   @unique
  name      String
  memoryMb  Int      @default(256) // overrides hostnsoft-deploy's default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // See docs/Anonymous-deploy-req.md. orphanExpiresAt is computed once,
  // at creation, from the TTL config in effect at that moment — not
  // derived from createdAt at delete-time — so a later TTL config change
  // never retroactively changes an already-quoted deletion time.
  isOrphan        Boolean   @default(false)
  orphanExpiresAt DateTime?

  // SHA-256 of the one-time claim code in the claim link handed back on
  // the deploy that created this orphan (see services/projectClaim.ts and
  // lib/orphanClaim.ts). Only the hash is stored, like a deploy token:
  // the code itself appears once, in that first deploy response, and
  // never again. Cleared when the project is claimed by either path. Null
  // on orphans created before this column existed — those can only be
  // claimed by redeploying with a token.
  claimCodeHash String?

  // The Deployment currently live on this project — set on every
  // successful deploy (internalDeployments.routes.ts) and every
  // successful rollback (deployments.routes.ts), so "what's actually
  // running" is a direct read rather than a derived "latest success"
  // query repeated in multiple places. Plain string, not a formal
  // relation, to keep with this schema's convention of not tying down
  // a Project row's shape to Deployment's (e.g. onDelete behavior) for
  // what's fundamentally just a pointer.
  currentDeploymentId String?

  // How the app is currently deployed: "service" (built and run as a
  // job) or "static" (files served directly, no server process — see
  // hostnsoft-deploy's docs/Static-apps-req.md). A string rather than a
  // boolean so further kinds can be added later without a schema change
  // (same convention as Domain.status / Deployment.status). Reported by
  // hostnsoft-deploy on every SUCCESSFUL deploy via
  // POST /internal/deployments/record (`kind`), since only it knows what
  // railpack detected; never set from this API's own routes. Read by the
  // dashboard to hide the env-var and memory controls for a static app,
  // which has no use for them (nothing runs that could read an env var).
  // Not a separate Deployment column: an app's kind only ever moves
  // service -> static, and a rollback can't change it, so the project is
  // the right place for it. Defaults to "service" — every app that
  // predates this column is treated as a server app until its next
  // successful deploy says otherwise.
  kind String @default("service")

  // What the app is FOR, in the deployer's own words ("portfolio", "task
  // management", "feedback system"...). Optional and free text: sent by
  // the deploying agent/person as hostnsoft-deploy's X-App-Type header,
  // relayed here through POST /internal/projects/claim. Only ever
  // overwritten by a deploy that sends one — a redeploy without the
  // header keeps the previous value rather than clearing it.
  appType String?

  deployments Deployment[]
  envVars     EnvVar[]
  domains     Domain[]
  appDetails  AppDetails?

  @@index([companyId])
}

// A client-owned domain (or subdomain) attached to a project — see
// docs/Customdomain-req.md. `domain` is unique platform-wide: two
// projects (even in different companies) can never both claim the same
// domain, so a create-then-catch-conflict against this unique constraint
// is how "already claimed by another project" is enforced.
model Domain {
  id             String    @id @default(cuid())
  projectId      String
  domain         String    @unique
  // "apex" | "subdomain" — determines whether DNS instructions are an A
  // record (apex) or a CNAME (subdomain); see src/lib/customDomain.ts.
  type           String
  // "pending_dns" | "active" | "failed" — see docs/Customdomain-req.md.
  // "failed" covers both "never verified" and "was active, then DNS
  // stopped pointing here" (see the periodic re-verification loop).
  status         String    @default("pending_dns")
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Versioned deploy history — one row per deploy attempt.
model Deployment {
  id        String @id @default(cuid())
  projectId String

  // This project's own deploy sequence number ("v1", "v2", ...), assigned
  // server-side. Kept separate from appVersion because a user can redeploy
  // without bumping their app's version, so appVersion can't identify a
  // deploy attempt.
  version String

  // Whatever hostnsoft-deploy used as the image tag (the raw X-App-Version,
  // or its timestamp fallback). Informational; NOT unique.
  appVersion String

  imageTag    String?
  memoryMb    Int?
  status      String // "success" | "failed" | "in_progress"
  errorDetail String?
  triggeredBy String? // proxy userId, or a deploy token label/prefix

  // Where this deploy came from, as a category: "dashboard" (a person in
  // the dashboard — upload, rollback) or "agent" (anything holding a
  // deploy token: an AI agent, CI, a script). Derived here from the
  // credential, never taken from the request. Null only on rows older
  // than this column that the migration couldn't classify.
  source String?

  // Which agent, in its own words ("claude-code", "chatgpt", "cursor"...),
  // from the optional X-Agent-Name header. Self-reported and unverified —
  // useful for "who's deploying with us", not for access decisions. Null
  // when not sent, and always null for a dashboard deploy.
  agentName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String? // proxy userId of last mutator

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

// Internal admin flag, gating /admin/* routes — see docs/admin-panel.md.
// Deliberately its own table, not a column on a "users" table, since there
// is no local user table at all (proxy owns identity — see header comment).
// Never written or read via any API/UI: the only way a row here is created
// is a direct DB write (see scripts/grant-super-admin.ts), by design — see
// docs/admin-panel.md Part 3 for why this stays permanently DB-only.
model SuperAdmin {
  userId    String   @id
  grantedAt DateTime @default(now())
}

// One submission from either path — see docs/request-feature-req.md.
// source tells the three paths apart ("dashboard" | "public" | "agent");
// which of the other optional fields are populated depends on it (see
// that doc's field table) rather than every field always being present.
model FeatureRequest {
  id          String   @id @default(cuid())
  type        String // see FEATURE_REQUEST_TYPES in src/services/featureRequests.ts
  message     String
  source      String // "dashboard" | "public" | "agent"
  email       String?
  userId      String? // proxy userId — dashboard path only
  companyId   String? // dashboard (URL) or agent (deploy token) — null for public/orphan
  projectSlug String? // agent path only — which app the agent was deploying
  agentName   String? // agent path only — free text, e.g. "claude-code", "chatgpt"
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

// Every mutating action: who, what, when. Ids are proxy ids kept as plain
// strings so audit rows outlive anything proxy deletes.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  companyId   String?
  projectId   String?
  action      String
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
  // Both slug-change lookups filter on `action` and take the newest
  // match: the cooldown (by project) and "where did this app go" (by
  // company, on an agent 404). Without these the residual `action`
  // filter walks every audit row the company or project has, which on
  // the 404 path is a request an unknown app name can trigger at will.
  @@index([projectId, action, createdAt])
  @@index([companyId, action, createdAt])
}
// ---------------------------------------------------------------- Showcase
// See docs/showcase.md. Two places an app can be shown:
//   public — the home gallery at /showcase. A flag on AppDetails.
//   event  — a ShowcaseEvent page at /showcase/<slug>, made by a company;
//            anyone's app can be listed there. One ShowcaseEventListing row
//            per (app, event).
// An app's details are written once (AppDetails, one row per Project) and
// reused by every place it is shown. Public is live at once; an event
// listing waits for the organiser unless the event's submitCode was given.

// Public-facing details of a deployed app. Not showcase-specific: anything
// that needs to describe an app can read it.
model AppDetails {
  id        String @id @default(cuid())
  // One row per app. The Showcase address is /showcase/app/<Project.slug>,
  // read through the relation — nothing here duplicates it.
  projectId String @unique
  companyId String
  // Proxy userId of whoever wrote the details.
  createdBy String

  tagline     String
  description String?
  story       String?
  // Snapshot: the project's active custom domain if it had one, else its
  // platform URL. Repointed by services/projectSlugChange.ts on a rename.
  appUrl         String
  screenshotUrls     String @default("[]")
  videoUrl       String?
  creatorName    String
  creatorProfile String?
  // JSON-encoded string[] — several people can contribute to one app.
  contributorEmails  String @default("[]")
  // Offered options only; enforced in services/showcase.ts (SQLite has no
  // enums under Prisma 5).
  builtWith String?
  category  String?
  // JSON-encoded string[] — SQLite has no array column.
  tagsJson String @default("[]")
  // Creator-supplied HTML rendered on the app details page. Stored raw; the
  // panel sanitises on render.
  customHtml String?

  // Shown on the /showcase home gallery.
  isPublic Boolean @default(false)
  // Super admin's: ordered ahead of the rest on the home gallery.
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listings ShowcaseEventListing[]

  @@index([companyId])
  @@index([isPublic, featured, createdAt])
}

// An event page, /showcase/<slug>: a hackathon, a demo day. Made by a
// company from its console; any company's members can list their own apps.
model ShowcaseEvent {
  id String @id @default(cuid())
  // Immutable once created — it's an address people will have shared.
  // Lowercase letters, digits, dashes; see eventSlugSchema for the rule.
  slug  String  @unique
  title String
  intro String?
  // Proxy company id of the organiser.
  companyId String
  createdBy String
  // Handed out by the organiser. A submission carrying it is approved at
  // once; without it the organiser reviews. Generated in services/showcase.ts.
  submitCode String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings ShowcaseEventListing[]

  @@index([companyId])
}

// One app shown on one event page.
model ShowcaseEventListing {
  id           String @id @default(cuid())
  appDetailsId String
  eventId      String
  // Proxy userId of the member who listed it.
  addedBy String
  // pending | approved | rejected (LISTING_STATUSES in services/showcase.ts;
  // SQLite has no enums). Only approved listings are public.
  status          String    @default("pending")
  rejectionReason String?
  // Organiser member who approved or rejected, and when.
  reviewedBy String?
  reviewedAt DateTime?
  // The organiser's switch: hides an approved listing from the event's
  // public page without removing it.
  isHidden Boolean @default(false)

  createdAt DateTime @default(now())

  app   AppDetails    @relation(fields: [appDetailsId], references: [id], onDelete: Cascade)
  event ShowcaseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Once per event; any number of events.
  @@unique([appDetailsId, eventId])
  @@index([eventId, status, isHidden])
}
