// Identity lives on MSG91 proxy: there is deliberately no User, Company or
// CompanyMembership model. Every userId/companyId below is a plain string
// holding the PROXY id — no foreign key, since the referenced rows aren't
// ours. Consequence: a company deleted on proxy leaves its Project and
// DeployToken rows orphaned (nothing signals us).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// A deploy token. Only the hash is stored; the raw token is shown once at
// creation, like a GitHub PAT. Two kinds (`kind`, added 2026-10-21):
//   "workspace" — the token IS the company identity: it reaches the apps of
//     `companyId` and nothing else, whoever minted it, for as long as it
//     lives. For CI and shared machines, where the work must not stop when
//     the person who set it up leaves.
//   "user" — the token acts AS `createdBy`: it reaches every app in every
//     workspace that person can reach, checked live on each call
//     (src/lib/permissions.ts can()), so losing membership loses access at
//     once. `companyId` keeps its column but changes meaning: it is the
//     token's DEFAULT workspace — where a deploy of a brand-new app lands —
//     and the workspace whose token list shows it (and whose members can
//     revoke it). Reusing the column rather than adding a defaultCompanyId
//     keeps every existing "tokens of this workspace" query correct for both
//     kinds. See src/services/tokenAccess.ts.
model DeployToken {
  id          String    @id @default(cuid())
  companyId   String
  createdBy   String
  label       String
  tokenHash   String    @unique
  tokenPrefix String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  // Where the token was minted: "dashboard" (a person in the UI), "agent"
  // (the public email endpoint), or "connector" (an AI client exchanging a
  // proxy_auth_token via POST /connector/token). String, not enum — SQLite.
  source      String    @default("dashboard")
  // "workspace" | "user" — see the model comment. String, not enum — SQLite.
  // Independent of `source`: source says who minted it, kind what it may
  // reach. The migration made every agent/connector token a user token,
  // since those were always minted for one signed-in person.
  kind        String    @default("workspace")

  @@index([companyId])
}

// One Project == one deployed app on hostnsoft-deploy. slug is the
// subdomain hostnsoft-deploy routes by (<slug>.embarko.app) and the
// X-App-Name it expects; it can change (services/projectSlugChange.ts), so
// anything that must keep finding the app holds `id` instead. name is just
// a display label.
// companyId/createdBy are null only for orphan (anonymous) projects — see
// docs/Anonymous-deploy-req.md — until a real deploy token claims them.
model Project {
  id        String   @id @default(cuid())
  companyId String?
  createdBy String?
  slug      String   @unique
  name      String
  memoryMb  Int      @default(256) // overrides hostnsoft-deploy's default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // See docs/Anonymous-deploy-req.md. orphanExpiresAt is computed once,
  // at creation, from the TTL config in effect at that moment — not
  // derived from createdAt at delete-time — so a later TTL config change
  // never retroactively changes an already-quoted deletion time.
  isOrphan        Boolean   @default(false)
  orphanExpiresAt DateTime?

  // SHA-256 of the one-time claim code in the claim link handed back on
  // the deploy that created this orphan (see services/projectClaim.ts and
  // lib/orphanClaim.ts). Only the hash is stored, like a deploy token:
  // the code itself appears once, in that first deploy response, and
  // never again. Cleared when the project is claimed by either path. Null
  // on orphans created before this column existed — those can only be
  // claimed by redeploying with a token.
  claimCodeHash String?

  // The Deployment currently live on this project — set on every
  // successful deploy (internalDeployments.routes.ts) and every
  // successful rollback (deployments.routes.ts), so "what's actually
  // running" is a direct read rather than a derived "latest success"
  // query repeated in multiple places. Plain string, not a formal
  // relation, to keep with this schema's convention of not tying down
  // a Project row's shape to Deployment's (e.g. onDelete behavior) for
  // what's fundamentally just a pointer.
  currentDeploymentId String?

  // How the app is currently deployed: "service" (built and run as a
  // job) or "static" (files served directly, no server process — see
  // hostnsoft-deploy's docs/Static-apps-req.md). A string rather than a
  // boolean so further kinds can be added later without a schema change
  // (same convention as Domain.status / Deployment.status). Reported by
  // hostnsoft-deploy on every SUCCESSFUL deploy via
  // POST /internal/deployments/record (`kind`), since only it knows what
  // railpack detected; never set from this API's own routes. Read by the
  // dashboard to hide the env-var and memory controls for a static app,
  // which has no use for them (nothing runs that could read an env var).
  // Not a separate Deployment column: an app's kind only ever moves
  // service -> static, and a rollback can't change it, so the project is
  // the right place for it. Defaults to "service" — every app that
  // predates this column is treated as a server app until its next
  // successful deploy says otherwise.
  kind String @default("service")

  // What the app is FOR, in the deployer's own words ("portfolio", "task
  // management", "feedback system"...). Optional and free text: sent by
  // the deploying agent/person as hostnsoft-deploy's X-App-Type header,
  // relayed here through POST /internal/projects/claim. Only ever
  // overwritten by a deploy that sends one — a redeploy without the
  // header keeps the previous value rather than clearing it.
  appType String?

  deployments            Deployment[]
  envVars                EnvVar[]
  domains                Domain[]
  schedules              Schedule[]
  appDetails             AppDetails?
  slugAliases            SlugAlias[]
  appGrants              AppGrant[]
  // At most one live row at a time (disable/rotate revoke rather than
  // delete), so this is a list only because revoked rows are kept.
  integrationsProject    IntegrationsProject?

  @@index([companyId])
}

// ------------------------------------------------------------------ Roles
// See docs/CLAUDE.md "Authorization" and src/lib/permissions.ts. Proxy still
// owns WHO is in a workspace (membership is checked there on every request,
// and removing someone there cuts them off whatever these rows say); these
// tables only say WHAT a member may do. Keyed by proxy ids, no foreign keys,
// same as everything else here.

// A member's role in one workspace. No row means "joined before roles
// existed, or through the proxy embed without going through our invite" —
// treated as Admin, which is what every member effectively was before this
// table (see permissions.ts DEFAULT_ROLE). Exactly one row per
// (workspace, person); the last Owner can't be removed or demoted
// (services/workspaceRoles.ts).
model WorkspaceMember {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  // "owner" | "admin" | "member" | "billing" (ROLES in permissions.ts; a
  // string, not an enum — SQLite).
  role      String
  // A Member's access (APP_ACCESS in permissions.ts): "use" | "edit" |
  // "full" on every app, apps added later included; or "chosen": only the
  // apps in AppGrant, at their level, the rest hidden. Always "full" on
  // what they created. Ignored for other roles.
  appAccess String   @default("use")
  // When they last did anything in this workspace (middleware/
  // companyContext.ts, at most once an hour). Null: not since this column
  // arrived. Shown as "last active" on the People page, nothing else.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId, role])
}

// One app a Member with appAccess "chosen" can reach, and how far: "use",
// "edit" (have their AI make changes as a preview; logs) or "full" (approve
// and publish, settings, delete, move) — ACCESS_LEVELS in permissions.ts.
// Ignored otherwise. Goes with the project.
model AppGrant {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  level     String // "use" | "edit" | "full"
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// A role chosen for someone before they are a member: the invite adds them
// on proxy and emails them (services/workspaceRoles.ts createInvite); this
// remembers what they should be allowed to do. Applied — turned into a WorkspaceMember
// (+ AppGrants) and deleted — the first time their permissions are worked
// out as a member of companyId (permissions.ts resolveAccess), matched by
// email. One per (workspace, email): inviting again replaces it.
model PendingInvite {
  id        String   @id @default(cuid())
  companyId String
  email     String // lowercased
  role      String
  appAccess String   @default("use") // as WorkspaceMember.appAccess
  // JSON-encoded [{projectId, level}] — SQLite has no array column.
  // Projects deleted in the meantime are skipped when applied.
  grants    String   @default("[]")
  invitedBy String
  createdAt DateTime @default(now())
  // Last time the invite email went out (create or resend). Null: only
  // the first send, before this column existed — createdAt then.
  lastSentAt DateTime?

  @@unique([companyId, email])
}

// A workspace's invite link — services/inviteLinks.ts. At most one live
// (disabledAt null) per workspace; "reset" disables it and makes a new one,
// so the old URL stops working at once. The code is the whole secret
// (randomBytes(24), base64url) and kept readable, unlike deploy tokens: it
// only lets someone *ask* to join after signing in, and the panel must be
// able to copy the link again at any time.
//
// rule: "anyone" (any signed-in person may ask), "domain" (only people
// whose proxy-verified email is on one of `domains`), "invite_only" (only
// emails with a PendingInvite). Joining always goes through a JoinRequest
// an Owner or Admin approves: proxy can only add someone to a company as a
// person already in it (msg91.ts addUserToCompany), so there is nobody to
// add them at the moment they click. `eligible` on the request says the
// link's rule let them in, so approving is one click.
model InviteLink {
  id         String    @id @default(cuid())
  companyId  String
  code       String    @unique
  rule       String    @default("anyone") // "anyone" | "domain" | "invite_only"
  domains    String    @default("[]") // JSON ["walkover.in"], lowercased
  // What people joining through it get: role "member" or "billing" only
  // (never Owner/Admin), access as WorkspaceMember.appAccess minus "chosen".
  role       String    @default("member")
  appAccess  String    @default("use")
  createdBy  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  uses       Int       @default(0)
  disabledAt DateTime?

  @@index([companyId, disabledAt])
}

// Someone asking to join a workspace, from its invite link —
// services/inviteLinks.ts. One row per (workspace, person): asking again
// after a refusal reopens it. Approved and rejected rows stay as history.
model JoinRequest {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  email     String // lowercased, from proxy's verified identity
  name      String?
  linkId    String?
  // true: the link's rule let them in (domain matched / anyone) —
  // false: they asked although it didn't.
  eligible  Boolean   @default(false)
  reason    String?
  status    String    @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedBy String?
  decidedAt DateTime?

  @@unique([companyId, userId])
  @@index([companyId, status])
}

// How far a workspace's roles have been set up (permissions.ts
// setUpWorkspaceRoles). Roles arrived after workspaces did, and who is in
// one and who made it are proxy facts SQL can't read, so each workspace is
// set up once, by the API, the first time it can ask proxy cleanly.
// ownerDecidedAt: its Owner was chosen (the creator, when proxy names one
// who is still a member). membersCapturedAt: everyone in it then was written
// as Admin — from then on a member with no row joined later, and starts as
// a Member. Until it is set, a member with no row counts as an Admin, so
// nobody already in a workspace ever loses anything.
model WorkspaceRoleSetup {
  companyId         String    @id
  ownerDecidedAt    DateTime?
  membersCapturedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// A name an app used to have — one row per previous slug, written on every
// successful address change (services/projectSlugChange.ts). A deploy or
// agent call that still uses the old name reaches the renamed app instead
// of creating a new one (services/projectClaim.ts resolveDeployTarget,
// slugChangeFlow.ts findRenamedApp). Keyed by slug, so an old name stays
// reserved for its app: nobody else can claim it, and renaming back to it
// removes the row.
model SlugAlias {
  slug      String   @id
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// A timed HTTP call into the app — see docs/schedules.md. The platform
// itself never runs app code on a timer: at each due time it sends
// GET <path> to the app's own address, through the same wake-up path a
// visitor takes, so a sleeping app wakes and the scale-to-zero logic needs
// no change.
model Schedule {
  id        String  @id @default(cuid())
  projectId String
  name      String? // free-text label, e.g. "daily digest"
  cron      String // five-field cron expression, evaluated in `timezone`
  timezone  String  @default("UTC") // IANA name
  path      String // starts with "/", query string allowed
  enabled   Boolean @default(true)

  // Optional extra failure/recovery destination, besides the owner's email.
  // Treated like a secret (Slack webhook URLs are bearer credentials):
  // never returned by any endpoint, only whether one is set and its host.
  alertWebhookUrl String?

  // When the runner next calls it. Advanced BEFORE a run starts (a
  // compare-and-set on the old value), so two runner processes can never
  // both fire the same occurrence. Null while disabled.
  nextRunAt DateTime?

  // Failure state for alerting: `failing` flips (and one alert goes out)
  // after SCHEDULE_ALERT_AFTER_FAILURES failed runs in a row, or once the
  // streak is SCHEDULE_ALERT_AFTER_HOURS old with no success, whichever
  // comes first; one more alert when it recovers — never one per failed run.
  consecutiveFailures Int       @default(0)
  failing             Boolean   @default(false)
  // When the current failure streak's first run started; null with no streak.
  failingSince        DateTime?

  createdBy String // proxy userId — the deploy token's creator on the agent path
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    ScheduleRun[]

  @@index([projectId])
  @@index([enabled, nextRunAt])
}

// One call the runner made (or chose not to make). Pruned to the newest
// SCHEDULE_RUN_HISTORY rows per schedule.
model ScheduleRun {
  id              String    @id @default(cuid())
  scheduleId      String
  // "manual" (POST .../run) | "schedule"
  trigger         String    @default("schedule")
  // "running" | "ok" | "failed" | "skipped" (previous run still in flight)
  outcome         String
  httpStatus      Int?
  error           String?
  // First SCHEDULE_RESPONSE_EXCERPT_BYTES of the response body, so an
  // agent can return a one-line summary of what the run did.
  responseExcerpt String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  durationMs      Int?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startedAt])
}

// A client-owned domain (or subdomain) attached to a project — see
// docs/Customdomain-req.md. `domain` is unique platform-wide: two
// projects (even in different companies) can never both claim the same
// domain, so a create-then-catch-conflict against this unique constraint
// is how "already claimed by another project" is enforced.
model Domain {
  id             String    @id @default(cuid())
  projectId      String
  domain         String    @unique
  // "apex" | "subdomain" — determines whether DNS instructions are an A
  // record (apex) or a CNAME (subdomain); see src/lib/customDomain.ts.
  type           String
  // "pending_dns" | "active" | "failed" — see docs/Customdomain-req.md.
  // "failed" covers both "never verified" and "was active, then DNS
  // stopped pointing here" (see the periodic re-verification loop).
  status         String    @default("pending_dns")
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Versioned deploy history — one row per deploy attempt.
model Deployment {
  id        String @id @default(cuid())
  projectId String

  // This project's own deploy sequence number ("v1", "v2", ...), assigned
  // server-side. Kept separate from appVersion because a user can redeploy
  // without bumping their app's version, so appVersion can't identify a
  // deploy attempt.
  version String

  // Whatever hostnsoft-deploy used as the image tag (the raw X-App-Version,
  // or its timestamp fallback). Informational; NOT unique.
  appVersion String

  imageTag    String?
  memoryMb    Int?
  status      String // "success" | "failed" | "in_progress"
  errorDetail String?
  triggeredBy String? // proxy userId, or a deploy token label/prefix

  // Where this deploy came from, as a category: "dashboard" (a person in
  // the dashboard — upload, rollback) or "agent" (anything holding a
  // deploy token: an AI agent, CI, a script). Derived here from the
  // credential, never taken from the request. Null only on rows older
  // than this column that the migration couldn't classify.
  source String?

  // Which agent, in its own words ("claude-code", "chatgpt", "cursor"...),
  // from the optional X-Agent-Name header. Self-reported and unverified —
  // useful for "who's deploying with us", not for access decisions. Null
  // when not sent, and always null for a dashboard deploy.
  agentName  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String? // proxy userId of last mutator

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

// Internal admin flag, gating /admin/* routes — see docs/admin-panel.md.
// Deliberately its own table, not a column on a "users" table, since there
// is no local user table at all (proxy owns identity — see header comment).
// Never written or read via any API/UI: the only way a row here is created
// is a direct DB write (see scripts/grant-super-admin.ts), by design — see
// docs/admin-panel.md Part 3 for why this stays permanently DB-only.
model SuperAdmin {
  userId    String   @id
  grantedAt DateTime @default(now())
}

// One submission from either path — see docs/request-feature-req.md.
// source tells the three paths apart ("dashboard" | "public" | "agent");
// which of the other optional fields are populated depends on it (see
// that doc's field table) rather than every field always being present.
model FeatureRequest {
  id          String   @id @default(cuid())
  type        String // see FEATURE_REQUEST_TYPES in src/services/featureRequests.ts
  message     String
  source      String // "dashboard" | "public" | "agent"
  email       String?
  userId      String? // proxy userId — dashboard path only
  companyId   String? // dashboard (URL) or agent (deploy token) — null for public/orphan
  projectSlug String? // agent path only — which app the agent was deploying
  agentName   String? // agent path only — free text, e.g. "claude-code", "chatgpt"
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

// Every mutating action: who, what, when. Ids are proxy ids kept as plain
// strings so audit rows outlive anything proxy deletes.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  companyId   String?
  projectId   String?
  action      String
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
  // Both slug-change lookups filter on `action` and take the newest
  // match: the cooldown (by project) and "where did this app go" (by
  // company, on an agent 404). Without these the residual `action`
  // filter walks every audit row the company or project has, which on
  // the 404 path is a request an unknown app name can trigger at will.
  @@index([projectId, action, createdAt])
  @@index([companyId, action, createdAt])
}

// ---------------------------------------------------------------- Showcase
// See docs/showcase.md. Two places an app can be shown:
//   public — the home gallery at /showcase. A flag on AppDetails.
//   event  — a ShowcaseEvent page at /showcase/<slug>, made by a company;
//            anyone's app can be listed there. One ShowcaseEventListing row
//            per (app, event).
// An app's details are written once (AppDetails, one row per Project) and
// reused by every place it is shown. Public is live at once; an event
// listing waits for the organiser unless the event's submitCode was given.

// Public-facing details of a deployed app. Not showcase-specific: anything
// that needs to describe an app can read it.
model AppDetails {
  id        String @id @default(cuid())
  // One row per app. The Showcase address is /showcase/app/<Project.slug>,
  // read through the relation — nothing here duplicates it.
  projectId String @unique
  companyId String
  // Proxy userId of whoever wrote the details.
  createdBy String

  tagline           String
  description       String?
  story             String?
  // Snapshot: the project's active custom domain if it had one, else its
  // platform URL. Repointed by services/projectSlugChange.ts on a rename.
  appUrl            String
  screenshotUrls    String  @default("[]")
  videoUrl          String?
  creatorName       String
  creatorProfile    String?
  // JSON-encoded string[] — several people can contribute to one app.
  contributorEmails String  @default("[]")
  // Offered options only; enforced in services/showcase.ts (SQLite has no
  // enums under Prisma 5).
  builtWith         String?
  category          String?
  // JSON-encoded string[] — SQLite has no array column.
  tagsJson          String  @default("[]")
  // Creator-supplied HTML rendered on the app details page. Stored raw; the
  // panel sanitises on render.
  customHtml        String?

  // Shown on the /showcase home gallery.
  isPublic Boolean @default(false)
  // Super admin's: ordered ahead of the rest on the home gallery.
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listings ShowcaseEventListing[]

  @@index([companyId])
  @@index([isPublic, featured, createdAt])
}

// An event page, /showcase/<slug>: a hackathon, a demo day. Made by a
// company from its console; any company's members can list their own apps.
model ShowcaseEvent {
  id          String  @id @default(cuid())
  // Immutable once created — it's an address people will have shared.
  // Lowercase letters, digits, dashes; see eventSlugSchema for the rule.
  slug        String  @unique
  title       String
  intro       String?
  // Proxy company id of the organiser.
  companyId   String
  createdBy   String
  // Handed out by the organiser. A submission carrying it is approved at
  // once; without it the organiser reviews. Generated in services/showcase.ts.
  submitCode  String  @unique
  // Organiser's switch. On: every submission is approved at once, code or
  // not. Off (default): pending until reviewed, unless the code matches.
  autoApprove Boolean @default(false)
  // Organiser-supplied HTML shown on the event page, above the apps: rules,
  // schedule, sponsors. Stored raw, capped at 50k by the API; the panel
  // renders it in a sandboxed frame with scripts off. The one field an
  // organiser can change after creating the page.
  customHtml  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings ShowcaseEventListing[]

  @@index([companyId])
}

// One app shown on one event page.
model ShowcaseEventListing {
  id              String    @id @default(cuid())
  appDetailsId    String
  eventId         String
  // Proxy userId of the member who listed it.
  addedBy         String
  // pending | approved | rejected (LISTING_STATUSES in services/showcase.ts;
  // SQLite has no enums). Only approved listings are public.
  status          String    @default("pending")
  rejectionReason String?
  // Organiser member who approved or rejected, and when.
  reviewedBy      String?
  reviewedAt      DateTime?
  // The organiser's switch: hides an approved listing from the event's
  // public page without removing it.
  isHidden        Boolean   @default(false)

  createdAt DateTime @default(now())

  app   AppDetails    @relation(fields: [appDetailsId], references: [id], onDelete: Cascade)
  event ShowcaseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Once per event; any number of events.
  @@unique([appDetailsId, eventId])
  @@index([eventId, status, isHidden])
}

// Local mirror of the few company facts the proxy doesn't hold. Identity
// still lives on MSG91 proxy; `id` is the proxy companyId. planCode is the
// last Lago plan we saw (written on assignPlan + the Lago webhook) and is
// only read when Lago is unreachable.
model Company {
  id               String   @id
  planCode         String?
  lagoCustomerId   String?
  stripeCustomerId String?
  // Integrations for this workspace. Off by default; only an Owner turns
  // it on, and no app in the workspace can enable Integrations until then.
  integrationsEnabled Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------- Integrations
// See docs/integrations.md. Embarko gives each workspace a hidden
// workspace on viasocket (the integration engine), and each app that
// turns Integrations on an embed project inside it. The app receives the
// ids and the workspace's key as env vars and loads viasocket's embed
// itself. Keyed by proxy companyId with no foreign key, same as
// everything else here. Nothing a customer sees names viasocket.

// The viasocket workspace behind one Embarko workspace. Created on first
// use (services/integrationsWorkspace.ts) and never deleted.
model IntegrationsWorkspace {
  companyId   String   @id
  // viasocket's `company_id` — the <org_id> its API addresses the workspace by.
  orgId       String
  // viasocket's `org_id` — the workspace's NAME ("72191-Embarko-<id>"). Support-facing only.
  orgName     String
  // The person whose SSO login created the workspace: the member who first
  // opened the builder, or the workspace Owner on the agent path. Logging
  // in again as them is how later API calls get a session.
  ownerEmail  String
  ownerUserId String
  // The workspace's own auth key (GET /orgs/<org_id>/token). Signs the
  // embed tokens the customer's app mints. Secret: never returned by any
  // endpoint, reaches apps only as an env var.
  authKey     String
  createdBy   String
  createdAt   DateTime @default(now())
}

// One app's embed project on viasocket. Title "Embarko-<projectId>", never
// the slug, since a slug can change. Goes with the project.
model IntegrationsProject {
  projectId      String   @id
  companyId      String
  embedProjectId String
  // The key this app signs embed tokens with. Today a copy of the
  // workspace's key (viasocket issues one per workspace); viasocket is
  // moving to one key per project, and then this is where it lives.
  authKey        String
  createdBy      String
  createdAt      DateTime @default(now())
  // Set when Integrations is turned off for the app; cleared when turned
  // on again. The row is never deleted while the app exists: it is
  // Embarko's only record of which viasocket project is this app's, and
  // the person's flows live in that project.
  disabledAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
